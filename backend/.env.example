PORT=3000
# MongoDB Atlas connection string (never commit the real one)
DB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heartai?retryWrites=true&w=majority
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string
NODE_ENV=development
# Comma-separated origins allowed to call the API with cookies
ALLOWED_ORIGINS=http://localhost:5173
# Email: Brevo HTTP API in production (Render's free tier blocks SMTP)
BREVO_API_KEY=
EMAIL_FROM=verified-sender@example.com
# Email fallback for local development when BREVO_API_KEY is empty (Gmail SMTP + app password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
